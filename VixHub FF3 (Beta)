-- ===== remove all textures (map) =====
local texBackup = {}
local texConn

-- true if the instance is a football or lives inside one
local function isBall(inst)
	local p = inst
	while p and p ~= workspace do
		if p.Name == "Football" then return true end
		p = p.Parent
	end
	return false
end

-- leave player avatars alone
local function inCharacter(inst)
	local m = inst:FindFirstAncestorOfClass("Model")
	while m do
		if m:FindFirstChildOfClass("Humanoid") then return true end
		m = m.Parent and m.Parent:FindFirstAncestorOfClass("Model") or nil
	end
	return false
end

local function stripTexture(inst)
	if texBackup[inst] ~= nil or isBall(inst) or inCharacter(inst) then return end
	if inst:IsA("Decal") or inst:IsA("Texture") then
		texBackup[inst] = { Transparency = inst.Transparency }
		inst.Transparency = 1
	elseif inst:IsA("SurfaceAppearance") then
		texBackup[inst] = { Parent = inst.Parent }
		inst.Parent = nil
	elseif inst:IsA("MeshPart") then
		texBackup[inst] = { TextureID = inst.TextureID, Material = inst.Material }
		inst.TextureID = ""
		inst.Material = Enum.Material.SmoothPlastic
	elseif inst:IsA("BasePart") and not inst:IsA("Terrain") then
		texBackup[inst] = { Material = inst.Material }
		inst.Material = Enum.Material.SmoothPlastic
	end
end

local function setNoTextures(on)
	visuals.noTextures = on
	if texConn then texConn:Disconnect(); texConn = nil end

	if on then
		texConn = workspace.DescendantAdded:Connect(stripTexture)
		task.spawn(function()
			local n = 0
			for _, inst in ipairs(workspace:GetDescendants()) do
				if not visuals.noTextures then return end
				stripTexture(inst)
				n += 1
				if n % 500 == 0 then task.wait() end -- don't freeze the game on big maps
			end
		end)
	else
		for inst, data in pairs(texBackup) do
			pcall(function()
				for k, v in pairs(data) do
					if k ~= "Parent" then inst[k] = v end
				end
				if data.Parent then inst.Parent = data.Parent end
			end)
		end
		table.clear(texBackup)
	end
end

-- ===== football texture + color =====
-- every "Football" in the workspace (loose, in a hand, or inside a model) is tracked
local ballRoots = {}
local ballBackup = {}

local function registerBall(inst)
	if inst.Name == "Football" and (inst:IsA("BasePart") or inst:IsA("Model")) then
		ballRoots[inst] = true
	end
end

-- remember a property once so it can be restored later
local function save(inst, prop)
	local b = ballBackup[inst]
	if not b then b = {}; ballBackup[inst] = b end
	if b[prop] == nil then
		local ok, v = pcall(function() return inst[prop] end)
		if ok then b[prop] = v end
	end
end

local function restoreBalls()
	for inst, props in pairs(ballBackup) do
		pcall(function()
			for k, v in pairs(props) do
				if k ~= "Parent" then inst[k] = v end
			end
			if props.Parent then inst.Parent = props.Parent end
		end)
	end
	table.clear(ballBackup)
end

-- applies the texture removal / color to a ball and everything inside it
local function applyBall(root, color)
	-- a color only shows if the texture is gone, so color also strips textures
	local stripTex = visuals.noBallTexture or visuals.ballColor

	local list = { root }
	for _, d in ipairs(root:GetDescendants()) do list[#list + 1] = d end

	for _, d in ipairs(list) do
		if d:IsA("BasePart") then
			if stripTex and d:IsA("MeshPart") and d.TextureID ~= "" then
				save(d, "TextureID")
				d.TextureID = ""
			end
			if visuals.ballColor then
				save(d, "Color")
				save(d, "Material")
				d.Color = color
				d.Material = Enum.Material.SmoothPlastic
			end
		elseif d:IsA("Decal") or d:IsA("Texture") then
			if stripTex and d.Transparency ~= 1 then
				save(d, "Transparency")
				d.Transparency = 1
			end
		elseif d:IsA("SurfaceAppearance") then
			if stripTex then
				save(d, "Parent")
				d.Parent = nil
			end
		elseif d:IsA("SpecialMesh") then
			if stripTex and d.TextureId ~= "" then
				save(d, "TextureId")
				d.TextureId = ""
			end
			if visuals.ballColor then
				save(d, "VertexColor")
				d.VertexColor = Vector3.new(1, 1, 1)
			end
		end
	end
end

-- find footballs that already exist, then watch for new ones
task.spawn(function()
	local n = 0
	for _, inst in ipairs(workspace:GetDescendants()) do
		registerBall(inst)
		n += 1
		if n % 500 == 0 then task.wait() end
	end
end)
local ballAddedConn = workspace.DescendantAdded:Connect(registerBall)

-- runs every frame so it wins even if the game resets the ball
local ballLoopConn
ballLoopConn = RunService.RenderStepped:Connect(function()
	if not gui.Parent then
		ballLoopConn:Disconnect()
		return
	end
	if not (visuals.noBallTexture or visuals.ballColor) then return end

	local color = Color3.fromRGB(visuals.r, visuals.g, visuals.b)
	for root in pairs(ballRoots) do
		if root:IsDescendantOf(workspace) then
			applyBall(root, color)
		else
			ballRoots[root] = nil
		end
	end
end)

-- GUI closed: put everything back
gui.Destroying:Connect(function()
	ballAddedConn:Disconnect()
	setNoTextures(false)
	visuals.noBallTexture = false
	visuals.ballColor = false
	restoreBalls()
end)

--------------------------------------------------------------------
-- LOGIC: AUTOFLIP (original pivot flip)
--------------------------------------------------------------------
local pack = nil
local jumped = false
local dived = false

local function resetAutoFlip()
	if pack then
		if pack.ha then pack.ha:Destroy() end
		if pack.ra then pack.ra:Destroy() end
		if pack.pivot then pack.pivot:Destroy() end
		if pack.spin then pack.spin:Destroy() end
	end
	pack = nil
end

local function autoFlipImpulse(root, head)
	resetAutoFlip()

	local m = math.max(root.AssemblyMass, 1)

	local ha = Instance.new("Attachment")
	ha.Parent = head

	local pivot = Instance.new("AlignPosition")
	pivot.Mode = Enum.PositionAlignmentMode.OneAttachment
	pivot.Attachment0 = ha
	pivot.Position = head.Position + Vector3.new(0, 0.15, 0)
	pivot.MaxForce = 180000
	pivot.Responsiveness = 120
	pivot.RigidityEnabled = false
	pivot.ApplyAtCenterOfMass = false
	pivot.Parent = head

	local ra = Instance.new("Attachment")
	ra.Parent = root

	local spin = Instance.new("AngularVelocity")
	spin.Attachment0 = ra
	spin.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
	spin.AngularVelocity = Vector3.new(-10, 0, 0)
	spin.MaxTorque = 50000
	spin.Parent = root

	root:ApplyAngularImpulse(root.CFrame.RightVector * (-16 * m))

	pack = { ha = ha, pivot = pivot, ra = ra, spin = spin }

	task.delay(0.25, function()
		resetAutoFlip()
	end)
end

task.spawn(function()
	while gui.Parent do
		task.wait()

		if not flipState.auto then
			resetAutoFlip()
			jumped = false
			dived = false
			continue
		end

		local char = player.Character
		if not char then continue end

		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local head = char:FindFirstChild("Head")

		if not hum or not hrp or not head then continue end

		if hum:GetState() == Enum.HumanoidStateType.Jumping then
			jumped = true
		end

		if hum.PlatformStand and jumped then
			dived = true
		end

		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char }

		local result = workspace:Raycast(head.Position, Vector3.new(0, -3, 0), params)
		local grounded = result ~= nil

		if grounded and jumped and dived then
			jumped = false
			dived = false
			autoFlipImpulse(hrp, head)
		end
	end

	-- GUI closed: clean up anything the flip left behind
	resetAutoFlip()
end)

