		checkTick.Visible = remember
		check.BackgroundColor3 = remember and RED or Color3.fromRGB(10, 2, 3)
	end)

	local getKey = new("TextButton", {
		Position = UDim2.fromOffset(10, 38),
		Size = UDim2.fromOffset(156, 28),
