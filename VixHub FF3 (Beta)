local function selectTab(tab)
	if currentTab == tab then return end
	for _, t in ipairs(tabs) do
		local active = (t == tab)
		t.page.Visible = active
		tween(t.button, { BackgroundColor3 = active and theme.purple or UI.panel }, 0.12)
		tween(t.stroke, { Color = active and theme.blue or UI.border }, 0.12)
		tween(t.label, { TextColor3 = active and theme.text or theme.muted }, 0.12)
	end
	currentTab = tab
end

