--------------------------------------------------------------------
-- RADIUS PREVIEW (sphere / cube / triangular prism, all around the ball)
--------------------------------------------------------------------
local function makePart(class, shape)
	local p = Instance.new(class)
	if shape then p.Shape = shape end
	p.Material = Enum.Material.Neon
	p.Transparency = 0.7
	p.CastShadow = false
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local circlePart = makePart("Part", Enum.PartType.Ball)
local boxPart    = makePart("Part", Enum.PartType.Block)
-- the triangle is two wedges back to back (a wedge is half a triangle)
local triA       = makePart("WedgePart")
local triB       = makePart("WedgePart")

local previews = {
	Circle   = { circlePart },
	Box      = { boxPart },
	Triangle = { triA, triB },
}

-- hides every preview except the one named in `except` (nil hides all)
local function hidePreviews(except)
	for key, list in pairs(previews) do
		if key ~= except then
			for _, p in ipairs(list) do p.Parent = nil end
		end
	end
end

local function drawPreview(shape, center, radius, color)
	radius = math.max(radius, 0.1)

	for _, p in ipairs(previews[shape]) do
		p.Color = color
		p.Parent = workspace.Terrain
	end

	if shape == "Circle" then
		-- real sphere, centered on the ball, edge = exact catch radius
		local d = radius * 2
		circlePart.Size = Vector3.new(d, d, d)
		circlePart.CFrame = CFrame.new(center)

	elseif shape == "Box" then
		-- cube that fits inside the catch sphere, so everything in it is in range
		local s = radius * 2 / math.sqrt(3)
		boxPart.Size = Vector3.new(s, s, s)
		boxPart.CFrame = CFrame.new(center)

	else
		-- upright equilateral triangle prism, its corners touch the catch radius
		local w = radius * math.sqrt(3) -- base width
		local h = radius * 1.5          -- height
		local len = radius              -- how far it extends front to back
		local mid = center + Vector3.new(0, h / 6, 0) -- centroid sits on the ball

		triA.Size = Vector3.new(len, h, w / 2)
		triA.CFrame = CFrame.new(mid + Vector3.new(0, 0, -w / 4))

		triB.Size = Vector3.new(len, h, w / 2)
		triB.CFrame = CFrame.new(mid + Vector3.new(0, 0, w / 4)) * CFrame.Angles(0, math.pi, 0)
	end
end

