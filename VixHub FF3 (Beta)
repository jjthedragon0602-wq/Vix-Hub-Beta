			setOpen(true)
			openDropdown = function() setOpen(false) end
		end
	end)

	render()
	register("options:" .. title, function() return selected end, function(v)
		if items[v] then
			selected = v
			render()
			if callback then task.spawn(callback, v) end
		end
	end)

	grow(parent, y + 22)
	return {
		Set = function(v) selected = v; render() end,
		Get = function() return selected end,
