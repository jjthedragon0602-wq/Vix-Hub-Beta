-- AUTOMATICS: AUTO TACKLE + AUTO SWAT
--------------------------------------------------------------------
do
	local VIM = game:GetService("VirtualInputManager")

	local tackle = { enabled = false, range = 12, face = true, input = "Key", key = Enum.KeyCode.Q, nextAt = 0 }
	local swat   = { enabled = false, range = 10, jump = true, input = "Key", key = Enum.KeyCode.E, nextAt = 0 }

	-- sends a key press or a mouse click to the game
	local function press(mode, key)
		task.spawn(function()
			if mode == "Click" then
				local m = UserInputService:GetMouseLocation()
				pcall(function()
					VIM:SendMouseButtonEvent(m.X, m.Y, 0, true, game, 0)
					task.wait(0.04)
					VIM:SendMouseButtonEvent(m.X, m.Y, 0, false, game, 0)
				end)
			else
				pcall(function()
					VIM:SendKeyEvent(true, key, false, game)
					task.wait(0.04)
					VIM:SendKeyEvent(false, key, false, game)
				end)
			end
		end)
	end

	-- other team (or anyone, in a game without teams)
	local function isEnemy(plr)
		if player.Team == nil or plr.Team == nil then return true end
		return plr.Team ~= player.Team
	end

	---------------- UI: Auto Tackle ----------------
	local tackleCard = automaticsSubs.Add("Tackle", 296, 90)

	addToggle(tackleCard, 4, "Auto Tackle", "Tackles the ball carrier when they get close", false, function(on)
		tackle.enabled = on
	end)
	cardDivider(tackleCard, 56)
	addSlider(tackleCard, 68, "Tackle Range", 5, 40, 12, "", function(v)
		tackle.range = v
	end, 1)
	cardDivider(tackleCard, 120)
	addToggle(tackleCard, 124, "Face Ball Carrier", "Turns you toward them before tackling", true, function(on)
		tackle.face = on
	end)
	cardDivider(tackleCard, 176)
	addOptions(tackleCard, 180, "Tackle Input", { "Key", "Click" }, "Key", function(v)
		tackle.input = v
	end)
	cardDivider(tackleCard, 236)
	addKeybind(tackleCard, 240, "Tackle Key", "The game's tackle / dive key", tackle.key, function(k)
		tackle.key = k
	end)

	---------------- UI: Auto Swat ----------------
	local swatCard = automaticsSubs.Add("Swat", 296, 80)

	addToggle(swatCard, 4, "Auto Swat", "Swats the ball when it flies close to you", false, function(on)
		swat.enabled = on
	end)
	cardDivider(swatCard, 56)
	addSlider(swatCard, 68, "Swat Range", 5, 30, 10, "", function(v)
		swat.range = v
	end, 1)
	cardDivider(swatCard, 120)
	addToggle(swatCard, 124, "Auto Jump", "Jumps for you right before the swat", true, function(on)
		swat.jump = on
	end)
	cardDivider(swatCard, 176)
	addOptions(swatCard, 180, "Swat Input", { "Key", "Click" }, "Key", function(v)
		swat.input = v
	end)
	cardDivider(swatCard, 236)
	addKeybind(swatCard, 240, "Swat Key", "The game's swat key", swat.key, function(k)
		swat.key = k
	end)

	---------------- logic ----------------
	task.spawn(function()
		while gui.Parent do
			task.wait(0.03)

			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not hrp or not hum or hum.Health <= 0 then continue end
			local now = os.clock()

			-- Auto Tackle: nearest enemy holding the football
			if tackle.enabled and now >= tackle.nextAt then
				local bestDist, bestRoot = math.huge, nil
				for _, plr in ipairs(Players:GetPlayers()) do
					if plr ~= player and isEnemy(plr) then
						local c = plr.Character
						local r = c and c:FindFirstChild("HumanoidRootPart")
						if r and c:FindFirstChild("Football", true) then
							local d = (r.Position - hrp.Position).Magnitude
							if d < bestDist then bestDist, bestRoot = d, r end
						end
					end
				end

				if bestRoot and bestDist <= tackle.range then
					if tackle.face then
						local flat = Vector3.new(bestRoot.Position.X, hrp.Position.Y, bestRoot.Position.Z)
						if (flat - hrp.Position).Magnitude > 0.1 then
							hrp.CFrame = CFrame.lookAt(hrp.Position, flat)
						end
					end
					tackle.nextAt = now + 0.8
					press(tackle.input, tackle.key)
				end
			end

			-- Auto Swat: a loose football that is flying toward you
			if swat.enabled and now >= swat.nextAt then
				local ball = findClosestBall()
				if ball then
					local toMe = hrp.Position - ball.Position
					local vel = ball.AssemblyLinearVelocity
					if toMe.Magnitude <= swat.range and vel.Magnitude > 10 and vel:Dot(toMe) > 0 then
						swat.nextAt = now + 0.6
						if swat.jump then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
						press(swat.input, swat.key)
					end
				end
			end
		end
	end)
end

