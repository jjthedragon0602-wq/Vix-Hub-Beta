-- slider row: [number box][bar............]  label
local function addSlider(parent, y, title, min, max, default, suffix, callback, step)
	step = step or 1
	y = Y(y)
	local function fmt(v)
		local onStep = math.abs(v / step - math.floor(v / step + 0.5)) < 1e-6
		if step < 0.1 then return string.format("%.2f", v) .. suffix end
		if step < 1 then
			return string.format(onStep and "%.1f" or "%.2f", v) .. suffix
		end
		if onStep and v == math.floor(v) then return tostring(v) .. suffix end
		return string.format("%.2f", v) .. suffix
	end

	-- number box (click it to type an exact value)
	local valueLabel = new("TextBox", {
		Position = UDim2.fromOffset(8, y),
		Size = UDim2.fromOffset(46, 22),
		BackgroundColor3 = UI.field,
		BorderSizePixel = 0,
		ClearTextOnFocus = true,
		Font = FONT_BOLD,
		Text = fmt(default),
		PlaceholderText = fmt(default),
		PlaceholderColor3 = theme.muted,
		TextColor3 = theme.text,
		TextSize = 12,
	}, parent)
	corner(valueLabel, 2)
	stroke(valueLabel, theme.purple, 0.35, 1)

	-- label on the right
	new("TextLabel", {
		Position = UDim2.new(CTRL_W, 6, 0, y),
		Size = UDim2.new(1 - CTRL_W, -12, 0, 22),
		BackgroundTransparency = 1,
		Font = FONT,
		Text = title,
		TextColor3 = theme.text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)

	-- larger invisible hit area so the thin bar is easy to grab
	local hit = new("TextButton", {
		Position = UDim2.fromOffset(60, y),
		Size = UDim2.new(CTRL_W, -68, 0, 22),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
	}, parent)

	local track = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = theme.edge,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
	}, hit)
	corner(track, 2)

	local fill = new("Frame", {
		Size = UDim2.fromScale((default - min) / (max - min), 1),
		BackgroundColor3 = theme.purple,
		BorderSizePixel = 0,
	}, track)
	corner(fill, 2)

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(6, 16),
		BackgroundColor3 = theme.text,
		BorderSizePixel = 0,
		ZIndex = 2,
	}, fill)
	corner(knob, 2)

	local dragging = false
	local current = default
	local function apply(v, exact)
		if not exact then v = math.floor(v / step + 0.5) * step end
		v = math.clamp(v, min, max)
		current = v
		fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
		valueLabel.Text = fmt(v)
		valueLabel.PlaceholderText = fmt(v)
		if callback then task.spawn(callback, v) end
	end
	local function update(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		apply(min + (max - min) * a)
	end
	register("slider:" .. title, function() return current end, function(v)
		if type(v) == "number" then apply(v, true) end
	end)

	-- typed number: accepts "7", "7.35", "-3.5", "25s" ...
	valueLabel.Focused:Connect(function() dragging = false end)
	valueLabel.FocusLost:Connect(function()
		local n = tonumber(valueLabel.Text:match("^%s*(-?%d*%.?%d+)"))
		if n then apply(n, true) else valueLabel.Text = fmt(current) end
	end)

	hit.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			update(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and isMove(input) then update(input.Position.X) end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then dragging = false end
	end)

	grow(parent, y + 22)
end

