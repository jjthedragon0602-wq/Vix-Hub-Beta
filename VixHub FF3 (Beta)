-- LOGIC: MANUAL FLIP (working flip, keyboard + controller)
--------------------------------------------------------------------
local function manualFlipImpulse(hrp)
	local ra = Instance.new("Attachment", hrp)
	local spin = Instance.new("AngularVelocity")
	spin.Attachment0 = ra
	spin.RelativeTo = Enum.ActuatorRelativeTo.Attachment0
	spin.AngularVelocity = Vector3.new(-6, 0, 0)
	spin.MaxTorque = 90000
	spin.Parent = hrp

	local m = math.max(hrp.AssemblyMass, 1)
	hrp:ApplyAngularImpulse(hrp.CFrame.RightVector * (-22 * m))

	task.delay(0.25, function()
		ra:Destroy()
		spin:Destroy()
	end)
end

UserInputService.InputBegan:Connect(function(input, gp)
	if isBinding then return end
	-- controller buttons are often "processed" by Roblox, so only skip that check for keyboard
	if gp and not isGamepad(input) then return end
	if not gui.Parent or not flipState.manual then return end
	if input.KeyCode ~= flipState.key and input.KeyCode ~= flipState.pad then return end
	if not flipState.canManual then return end

	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	flipState.canManual = false
	manualFlipImpulse(hrp)

	task.delay(0.4, function()
		flipState.canManual = true
