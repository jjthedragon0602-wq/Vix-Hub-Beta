-- EYE LOGO  (two big circles clipped to a lens, plus iris and pupil; used by the loader and the hub)
--------------------------------------------------------------------
local function makeEye(parent, color, position, anchor, scaleFactor)
	local eye = new("Frame", {
		AnchorPoint = anchor or Vector2.new(0.5, 0),
		Position = position,
		Size = UDim2.fromOffset(150, 64),
		BackgroundTransparency = 1,
	}, parent)
	if scaleFactor then new("UIScale", { Scale = scaleFactor }, eye) end

	new("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(240, 120),
		BackgroundTransparency = 1,
		Image = "rbxassetid://6014261993",
		ImageColor3 = color,
		ImageTransparency = 0.6,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(49, 49, 450, 450),
	}, eye)

	local lens = new("Frame", {
		Position = UDim2.fromOffset(0, 2),
		Size = UDim2.fromOffset(150, 60),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
	}, eye)
	local R = 109
	for _, isTop in ipairs({ true, false }) do
		local c = new("Frame", {
			AnchorPoint = isTop and Vector2.new(0.5, 0) or Vector2.new(0.5, 1),
			Position = UDim2.fromOffset(75, isTop and 0 or 60),
			Size = UDim2.fromOffset(R * 2, R * 2),
			BackgroundTransparency = 1,
		}, lens)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, c)
		stroke(c, color, 0, 3)
	end

	local iris = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(75, 32),
		Size = UDim2.fromOffset(42, 42),
		BackgroundTransparency = 1,
	}, eye)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, iris)
	stroke(iris, color, 0, 3)

	local pupil = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(75, 32),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	}, eye)
	new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, pupil)

	task.spawn(function() -- the pupil slowly breathes
		while eye.Parent do
			tween(pupil, { Size = UDim2.fromOffset(11, 11) }, 1.2, Enum.EasingStyle.Sine)
			task.wait(1.2)
			if not eye.Parent then break end
			tween(pupil, { Size = UDim2.fromOffset(17, 17) }, 1.2, Enum.EasingStyle.Sine)
			task.wait(1.2)
		end
	end)
	return eye
end

