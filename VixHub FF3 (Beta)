local visible = true
local busy = false

-- showBubble: true when hidden with the "–" button, false when hidden with RightShift
local function setVisible(state, showBubble)
	if state == visible or busy then return end
	visible = state
	busy = true

	if state then
		bubble.Visible = false
		scale.Scale = 0.92
		holder.Visible = true
		tween(scale, { Scale = 1 }, 0.28, Enum.EasingStyle.Back)
		task.delay(0.28, function() busy = false end)
	else
		tween(scale, { Scale = 0.92 }, 0.15)
		task.delay(0.15, function()
			holder.Visible = false
			bubble.Visible = showBubble == true
			busy = false
		end)
	end
end

