--------------------------------------------------------------------
-- HELPERS
--------------------------------------------------------------------
local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do inst[k] = v end
	inst.Parent = parent
	return inst
end

local function corner(inst, r)
	if r <= 20 then r = math.max(2, math.floor(r * 0.4)) end -- sharper, boxier look
	return new("UICorner", { CornerRadius = UDim.new(0, r) }, inst)
end

local function gradient(inst, c1, c2, rotation)
	return new("UIGradient", {
		Color = ColorSequence.new(c1 or theme.purple, c2 or theme.blue),
		Rotation = rotation or 0,
	}, inst)
end

local function stroke(inst, color, transparency, thickness)
	return new("UIStroke", {
		Color = color or theme.text,
		Transparency = transparency or 0.85,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, inst)
end

local function tween(inst, props, t, style, dir)
	local tw = TweenService:Create(
		inst,
		TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch
end

local function isMove(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch
end

local function divider(parent, y)
	return new("Frame", {
		Position = UDim2.new(0, 0, 0, y),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = theme.text,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
	}, parent)
end

--------------------------------------------------------------------
-- LOGO  (replaces the "V" badge with a real image)
--------------------------------------------------------------------
-- Put ONE of these between the quotes (leave "" to keep the V):
--   "rbxassetid://1234567890"        an image you uploaded to Roblox
--   "https://example.com/logo.png"   a direct link to a .png / .jpg
--   "mylogo.png"                     a file inside your executor's workspace folder
local LOGO = ""

-- Optional header banner image (an uploaded image): "rbxassetid://1234567890". Leave "" for the blue gradient.
local BANNER = ""

local logoUrl            -- the resolved image, once it's ready
local logoEntries = {}   -- every badge that should show it

local function paintLogo(e)
	if not logoUrl or not e.frame.Parent then return end
	e.image.Image = logoUrl
	e.image.Visible = true
	local label = e.frame:FindFirstChildOfClass("TextLabel")
	if label then label.Visible = false end
	local grad = e.frame:FindFirstChildOfClass("UIGradient")
	if grad then grad.Enabled = false end
	e.frame.BackgroundTransparency = 1
end

-- call on a badge frame; radius is the corner roundness as a fraction (0.5 = circle)
local function addLogo(frame, radius)
	local image = new("ImageLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Visible = false,
		ZIndex = 5,
	}, frame)
	new("UICorner", { CornerRadius = UDim.new(radius or 0.3, 0) }, image)
	local entry = { frame = frame, image = image }
	table.insert(logoEntries, entry)
	task.defer(paintLogo, entry)
end

task.spawn(function()
	if LOGO == "" then return end
	local src

	if LOGO:match("^rbxasset") then
		src = LOGO
	elseif tonumber(LOGO) then
		src = "rbxassetid://" .. LOGO
	elseif typeof(getcustomasset) == "function" and typeof(writefile) == "function" then
		pcall(function()
			if LOGO:match("^https?://") then
				local data = game:HttpGet(LOGO)
				if typeof(makefolder) == "function" and typeof(isfolder) == "function" and not isfolder("VysxenHub") then
					makefolder("VysxenHub")
				end
				writefile("VysxenHub/logo.png", data)
				src = getcustomasset("VysxenHub/logo.png")
			elseif isfile(LOGO) then
				src = getcustomasset(LOGO)
			end
		end)
	end

	if src then
		logoUrl = src
		for _, e in ipairs(logoEntries) do paintLogo(e) end
	else
		warn("[Vysxen] couldn't load the logo image, keeping the V")
	end
end)

