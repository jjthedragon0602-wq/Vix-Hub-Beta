			TextSize = 12,
			ZIndex = 2,
		}, btn)

		local card = makeCard(tab, 8)
		card.LayoutOrder = 2

		local s = { btn = btn, edge = edge, label = label, card = card }
		table.insert(subs, s)
		btn.MouseButton1Click:Connect(function() select(s) end)

		-- first button added is selected by default
		if #subs == 1 then select(s) else card.Visible = false end
		return card
	end

	return api
end

