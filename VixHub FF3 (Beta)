-- VISUALS: GAME FONT + CROSSHAIR BOX
--------------------------------------------------------------------
do
	---------------- game font ----------------
	-- every font Roblox ships; any name this client doesn't know is skipped
	local FONT_NAMES = {
		"Roboto", "RobotoCondensed", "RobotoMono", "Arial", "ArialBold", "Arimo", "ArimoBold",
		"SourceSans", "SourceSansBold", "SourceSansSemibold", "SourceSansLight", "SourceSansItalic",
		"Gotham", "GothamMedium", "GothamSemibold", "GothamBold", "GothamBlack",
		"Montserrat", "Ubuntu", "Nunito", "Oswald", "JosefinSans", "TitilliumWeb", "Merriweather",
		"Highway", "Michroma", "Jura", "Sarpanch", "Code", "SciFi", "Arcade",
		"Bangers", "Creepster", "DenkOne", "FredokaOne", "LuckiestGuy", "AmaticSC", "Fondamento",
		"GrenzeGotisch", "IndieFlower", "Kalam", "PatrickHand", "PermanentMarker", "SpecialElite",
		"Bodoni", "Garamond", "Cartoon", "Fantasy", "Antique", "Balthazar", "Legacy",
	}
	local fonts = {}
	for _, n in ipairs(FONT_NAMES) do
		local ok, f = pcall(function() return Enum.Font[n] end)
		if ok and f then table.insert(fonts, { name = n, enum = f }) end
	end

	local fontState = { enabled = false, selected = fonts[1].name, enum = fonts[1].enum, token = 0 }
	local fontBackup = setmetatable({}, { __mode = "k" }) -- [textObject] = original font
	local fontConns = {}

	local function isOurs(inst)
		for _, g in ipairs(ourGuis) do
			if g and inst:IsDescendantOf(g) then return true end
		end
		return false
	end

	local function applyFontTo(inst)
		if not (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) then return end
		if isOurs(inst) then return end
		if fontBackup[inst] == nil then fontBackup[inst] = inst.Font end
		pcall(function() inst.Font = fontState.enum end)
	end

	-- the game's menus (PlayerGui) plus names / signs in the world (Billboard / Surface guis)
	local function applyFontAll()
		fontState.token += 1
		local id = fontState.token
		task.spawn(function()
			local n = 0
			for _, root in ipairs({ player.PlayerGui, workspace }) do
				for _, d in ipairs(root:GetDescendants()) do
					if fontState.token ~= id or not fontState.enabled then return end
					applyFontTo(d)
					n += 1
					if n % 400 == 0 then task.wait() end
				end
			end
		end)
	end

	local function restoreFonts()
		fontState.token += 1
		for inst, f in pairs(fontBackup) do
			pcall(function() inst.Font = f end)
		end
		table.clear(fontBackup)
	end

	local function setFontEnabled(on)
		fontState.enabled = on
		for _, c in ipairs(fontConns) do c:Disconnect() end
		table.clear(fontConns)
		if on then
			table.insert(fontConns, player.PlayerGui.DescendantAdded:Connect(applyFontTo))
			table.insert(fontConns, workspace.DescendantAdded:Connect(applyFontTo))
			applyFontAll()
		else
			restoreFonts()
		end
	end

	local fontCard = visualsSubs.Add("Fonts", 320, 80)

	addToggle(fontCard, 4, "Change Game Font", "Replaces the font used by the game's text", false, setFontEnabled)
	cardDivider(fontCard, 56)

	new("TextLabel", {
		Position = UDim2.fromOffset(8, 34),
		Size = UDim2.new(1, -16, 0, 16),
		BackgroundTransparency = 1,
		Font = FONT_MED,
		Text = "Choose Font",
		TextColor3 = theme.text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, fontCard)

	local fontList = new("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 54),
		Size = UDim2.new(1, -16, 0, 190),
		BackgroundColor3 = theme.text,
		BackgroundTransparency = 0.94,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.purple,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, fontCard)
	corner(fontList, 10)
	stroke(fontList, theme.text, 0.9, 1)
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, fontList)
	new("UIPadding", {
		PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
	}, fontList)

	grow(fontCard, 54 + 190)
	local fontButtons = {}
	local function renderFonts()
		for name, b in pairs(fontButtons) do
			local on = (name == fontState.selected)
			b.BackgroundColor3 = on and theme.purple or theme.text
			b.BackgroundTransparency = on and 0.35 or 0.94
		end
	end

	local function selectFont(name)
		for _, f in ipairs(fonts) do
			if f.name == name then
				fontState.selected = name
				fontState.enum = f.enum
				renderFonts()
				if fontState.enabled then applyFontAll() end
				return
			end
		end
	end

	for i, f in ipairs(fonts) do
		local b = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 28),
			BackgroundColor3 = theme.text,
			BackgroundTransparency = 0.94,
			AutoButtonColor = false,
			Font = f.enum, -- each button previews its own font
			Text = f.name,
			TextColor3 = theme.text,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = i,
		}, fontList)
		corner(b, 8)
		new("UIPadding", { PaddingLeft = UDim.new(0, 10) }, b)
		b.MouseButton1Click:Connect(function() selectFont(f.name) end)
		fontButtons[f.name] = b
	end
	renderFonts()

	register("options:Game Font", function() return fontState.selected end, selectFont)

	---------------- crosshair box ----------------
	local box = { enabled = false, size = 20, alpha = 0.6 }
	local hiddenCross = setmetatable({}, { __mode = "k" }) -- [guiObject] = original Visible

	local boxGui = new("ScreenGui", {
		Name = "VysxenCrosshair",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
		DisplayOrder = GUI_ORDER + 1,
	}, GUI_PARENT)
	table.insert(ourGuis, boxGui)

	local boxFrame = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(box.size, box.size),
		BackgroundColor3 = Color3.fromRGB(55, 55, 60),
		BackgroundTransparency = box.alpha, -- see-through so you can still see what's behind it
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 10,
	}, boxGui)

	local function setBox(on)
		box.enabled = on
		if not on then
			boxFrame.Visible = false
			UserInputService.MouseIconEnabled = true
			for d, v in pairs(hiddenCross) do
				pcall(function() d.Visible = v end)
			end
			table.clear(hiddenCross)
		end
	end

	-- follows the mouse (or the screen center in shift lock) and hides the normal cursor
	local boxConn
	boxConn = RunService.RenderStepped:Connect(function()
		if not box.enabled then return end
		UserInputService.MouseIconEnabled = false
		local m = UserInputService:GetMouseLocation()
		boxFrame.Position = UDim2.fromOffset(m.X, m.Y)
		boxFrame.Size = UDim2.fromOffset(box.size, box.size)
		boxFrame.BackgroundTransparency = box.alpha
		boxFrame.Visible = true
	end)

	-- also hide a crosshair image the game draws itself
	task.spawn(function()
		while gui.Parent do
			task.wait(1)
			if box.enabled then
				for _, d in ipairs(player.PlayerGui:GetDescendants()) do
					if d:IsA("GuiObject") and not isOurs(d) then
						local n = d.Name:lower()
						if n:find("crosshair", 1, true) or n:find("reticle", 1, true) then
							if hiddenCross[d] == nil then hiddenCross[d] = d.Visible end
							d.Visible = false
						end
					end
				end
			end
		end
	end)

	local crossCard = visualsSubs.Add("Crosshair", 172, 90)

	addToggle(crossCard, 4, "Crosshair Box", "Turns your crosshair into a grey box", false, setBox)
	cardDivider(crossCard, 56)
	addSlider(crossCard, 68, "Box Size", 6, 60, 20, "", function(v)
		box.size = v
	end, 1)
	addSlider(crossCard, 120, "Box Transparency", 0, 1, 0.6, "", function(v)
		box.alpha = v
	end, 0.05)

	-- hub closed: put the font, cursor and game crosshair back
	gui.Destroying:Connect(function()
		setFontEnabled(false)
		setBox(false)
		if boxConn then boxConn:Disconnect() end
		boxGui:Destroy()
	end)
end

