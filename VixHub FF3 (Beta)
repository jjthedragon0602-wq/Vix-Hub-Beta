-- Remove Stadium
do
	local stadium = { enabled = false, name = "", token = 0 }
	local backup = {}   -- [instance] = original value, so it can all be put back

	local KEYWORDS = { "stadium", "stands", "crowd", "bleacher", "grandstand", "arena", "seats" }
	-- parts with these names are never hidden, so the field itself stays
	local KEEP = { "field", "turf", "grass", "ground", "yard", "endzone", "end zone", "goal", "hash", "line", "floor", "sideline", "spawn" }

	local function has(name, list)
		name = name:lower()
		for _, w in ipairs(list) do
			if name:find(w, 1, true) then return true end
		end
		return false
	end

	local function inCharacter(inst)
		local m = inst:FindFirstAncestorOfClass("Model")
		while m do
			if m:FindFirstChildOfClass("Humanoid") then return true end
			m = m.Parent and m.Parent:FindFirstAncestorOfClass("Model") or nil
		end
		return false
	end

	local status
	local function setStatus(text)
		if status then status.Text = text end
	end

	local function matches(inst)
		if inst:IsA("Terrain") or inst:IsA("Camera") then return false end
		if stadium.name ~= "" then return inst.Name:lower() == stadium.name:lower() end
		return has(inst.Name, KEYWORDS)
	end

	local function hideInst(d)
		if backup[d] ~= nil then return end
		if d:IsA("BasePart") then
			if d:IsA("Terrain") or has(d.Name, KEEP) or inCharacter(d) then return end
			backup[d] = d.Transparency
			d.Transparency = 1
		elseif d:IsA("Decal") or d:IsA("Texture") then
			backup[d] = d.Transparency
			d.Transparency = 1
		elseif d:IsA("ParticleEmitter") or d:IsA("Light") then
			backup[d] = d.Enabled
			d.Enabled = false
		end
	end

	local function restore()
		stadium.token += 1
		for inst, v in pairs(backup) do
			pcall(function()
				if type(v) == "number" then inst.Transparency = v else inst.Enabled = v end
			end)
		end
		table.clear(backup)
	end

	local function apply()
		stadium.token += 1
		local id = stadium.token
		setStatus("Looking for the stadium...")
		task.spawn(function()
			local roots, n = {}, 0
			for _, d in ipairs(workspace:GetDescendants()) do
				n += 1
				if n % 2000 == 0 then
					task.wait()
					if stadium.token ~= id or not stadium.enabled then return end
				end
				if matches(d) and not inCharacter(d) then roots[#roots + 1] = d end
			end

			local hidden = 0
			for _, r in ipairs(roots) do
				hideInst(r)
				for _, d in ipairs(r:GetDescendants()) do
					hideInst(d)
					hidden += 1
					if hidden % 500 == 0 then
						task.wait()
						if stadium.token ~= id or not stadium.enabled then return end
					end
				end
			end

			if #roots == 0 then
				setStatus("Nothing matched. Type the stadium's name above (names are in the console, F9).")
				print("[Vysxen] Remove Stadium: nothing matched. Top-level workspace objects:")
				for _, c in ipairs(workspace:GetChildren()) do
					print("  ", c.ClassName, c.Name)
				end
			else
				setStatus(("Hid %d object(s) from %d match(es)"):format(hidden, #roots))
			end
		end)
	end

	cardDivider(visualsCard, 336)

	addToggle(visualsCard, 340, "Remove Stadium", "Hides the stands and crowd around the field", false, function(on)
		stadium.enabled = on
		if on then apply() else restore(); setStatus("") end
	end)
	cardDivider(visualsCard, 396)

	new("TextLabel", {
		Position = UDim2.new(CTRL_W, 6, 0, Y(404)),
		Size = UDim2.new(1 - CTRL_W, -12, 0, 22),
		BackgroundTransparency = 1,
		Font = FONT,
		Text = "Stadium Name (optional)",
		TextColor3 = theme.text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, visualsCard)

	local boxFrame = new("Frame", {
		Position = UDim2.fromOffset(8, Y(404)),
		Size = UDim2.new(CTRL_W, -8, 0, 22),
		BackgroundColor3 = theme.text,
		BackgroundTransparency = 0.92,
		BorderSizePixel = 0,
	}, visualsCard)
	corner(boxFrame, 10)
	stroke(boxFrame, theme.purple, 0.5, 1)

	local nameBox = new("TextBox", {
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		Font = FONT_MED,
		PlaceholderText = "Leave empty to auto-detect",
		PlaceholderColor3 = theme.muted,
		Text = "",
		TextColor3 = theme.text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, boxFrame)

	status = new("TextLabel", {
		Position = UDim2.fromOffset(8, Y(404) + 26),
		Size = UDim2.new(1, -16, 0, 28),
		BackgroundTransparency = 1,
		Font = FONT,
		Text = "",
		TextColor3 = theme.muted,
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, visualsCard)

	grow(visualsCard, Y(404) + 56)

	nameBox.FocusLost:Connect(function()
		stadium.name = nameBox.Text:match("^%s*(.-)%s*$")
		if stadium.enabled then
			restore()
			apply()
		end
	end)
	register("text:Stadium Name", function() return stadium.name end, function(v)
		if type(v) == "string" then
			stadium.name = v
			nameBox.Text = v
		end
	end)

	-- hub closed: put the stadium back
	gui.Destroying:Connect(restore)
end

