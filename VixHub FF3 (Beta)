-- The hub lives in the executor's hidden gui container (or CoreGui) with a huge DisplayOrder,
-- so it draws ABOVE the Roblox escape / leave menu and stays clickable while that menu is open.
local function pickGuiParent()
	local ok, h = pcall(function() return gethui and gethui() end)
	if ok and typeof(h) == "Instance" then return h end
	local ok2 = pcall(function()
		Instance.new("Folder", game:GetService("CoreGui")):Destroy()
	end)
	if ok2 then return game:GetService("CoreGui") end
	return player:WaitForChild("PlayerGui") -- plain LocalScript fallback
end
