		PaddingLeft = UDim.new(0, 12),
		PaddingRight = UDim.new(0, 12),
		PaddingBottom = UDim.new(0, 14),
	}, tab.content)

	-- hover + click
	tab.button.MouseEnter:Connect(function()
		if currentTab ~= tab then tween(tab.label, { TextColor3 = theme.text }) end
	end)
	tab.button.MouseLeave:Connect(function()
		if currentTab ~= tab then tween(tab.label, { TextColor3 = theme.muted }) end
	end)
	tab.button.MouseButton1Click:Connect(function() selectTab(tab) end)

	table.insert(tabs, tab)
	if #tabs == 1 then selectTab(tab) end
	return tab
end

