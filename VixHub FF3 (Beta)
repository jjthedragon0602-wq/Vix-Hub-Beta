	-- Compact share codes use a stable sorted registry-key order. The VX1 prefix
	-- identifies the format; legacy JSON object codes remain importable below.
	local function getSortedConfigKeys()
		local keys = {}
		for key in pairs(registry) do table.insert(keys, key) end
		table.sort(keys)
		return keys
	end

	addButtonPair(hubCard, 378, "Export (Copy)", function()
		local keys = getSortedConfigKeys()
		local values = {}
		for i, key in ipairs(keys) do
			local entry = registry[key]
			local ok, value = pcall(entry.get)
			values[i] = (ok and value ~= nil) and value or false
		end
		local code = "VX1:" .. HttpService:JSONEncode(values)
		codeBox.Text = code
		if typeof(setclipboard) == "function" then
			pcall(setclipboard, code)
			notify("Compact config code copied")
		else
			notify("Compact config code ready (copy it from the box)")
		end
	end, "Import", function()
		local raw = codeBox.Text
		if string.sub(raw, 1, 4) == "VX1:" then
			local ok, values = pcall(function() return HttpService:JSONDecode(string.sub(raw, 5)) end)
			if not ok or type(values) ~= "table" then
				notify("That isn't a valid compact config code")
				return
			end
			local keys = getSortedConfigKeys()
			if #values ~= #keys then
				notify("This share code is from a different hub version")
				return
			end
			for i, key in ipairs(keys) do
				if values[i] ~= false then
					local entry = registry[key]
					if entry then pcall(entry.set, values[i]) end
				end
			end
		else
			-- Backward compatibility for older full JSON config codes.
			local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
			if not ok or type(data) ~= "table" then
				notify("That isn't a valid config code")
				return
			end
			for key, value in pairs(data) do
				local entry = registry[key]
				if entry then pcall(entry.set, value) end
			end
		end
		notify("Config imported")
	end)
