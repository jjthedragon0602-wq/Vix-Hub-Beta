-- SETTINGS TAB UI  (save / load configs)
--------------------------------------------------------------------
local settingsSubs = makeSubTabs(settingsTab)

do
	local HttpService = game:GetService("HttpService")

	local CONFIG_DIR = "VysxenHub"
	local CONFIG_FOLDER = CONFIG_DIR .. "/configs"
	local AUTOLOAD_FILE = CONFIG_DIR .. "/autoload.txt"

	local canSave = typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
	local canList = typeof(listfiles) == "function"
	local canFolder = typeof(makefolder) == "function" and typeof(isfolder) == "function"

	local GREEN = Color3.fromRGB(34, 197, 94)
	local RED = Color3.fromRGB(239, 68, 68)

	local function ensureFolders()
		if not canFolder then return end
		pcall(function()
			if not isfolder(CONFIG_DIR) then makefolder(CONFIG_DIR) end
			if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
		end)
	end

	local function pathFor(name)
		return CONFIG_FOLDER .. "/" .. name .. ".json"
	end

	local function cleanName(text)
		local t = text:gsub("[^%w%s_%-]", "")
		return t:match("^%s*(.-)%s*$")
	end

	-- saved autoload name (if any)
	local autoName
	if canSave then
		pcall(function()
			if isfile(AUTOLOAD_FILE) then autoName = cleanName(readfile(AUTOLOAD_FILE)) end
		end)
	end
	if autoName == "" then autoName = nil end
	local autoOn = autoName ~= nil

	local card = settingsSubs.Add("Configs", 358, 90)

	new("TextLabel", {
		Position = UDim2.new(CTRL_W, 6, 0, 4),
		Size = UDim2.new(1 - CTRL_W, -12, 0, 24),
		BackgroundTransparency = 1,
		Font = FONT,
		Text = "Config Name",
		TextColor3 = theme.text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	local boxFrame = new("Frame", {
		Position = UDim2.fromOffset(8, 4),
		Size = UDim2.new(CTRL_W, -8, 0, 24),
		BackgroundColor3 = theme.text,
		BackgroundTransparency = 0.92,
		BorderSizePixel = 0,
	}, card)
	corner(boxFrame, 10)
	stroke(boxFrame, theme.purple, 0.5, 1)

	local nameBox = new("TextBox", {
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -24, 1, 0),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		Font = FONT_MED,
		PlaceholderText = "Type a config name",
		PlaceholderColor3 = theme.muted,
		Text = autoName or "default",
		TextColor3 = theme.text,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, boxFrame)

	local status = new("TextLabel", {
		Position = UDim2.fromOffset(8, 64),
		Size = UDim2.new(1, -16, 0, 16),
		BackgroundTransparency = 1,
		Font = FONT_MED,
		Text = canSave and "Ready" or "Your executor can't save files",
		TextColor3 = canSave and theme.muted or RED,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, card)
	local function setStatus(text, color)
		status.Text = text
		status.TextColor3 = color or theme.muted
	end

	-- the three action buttons
	local btnRow = new("Frame", {
		Position = UDim2.fromOffset(8, 34),
		Size = UDim2.new(1, -16, 0, 26),
		BackgroundTransparency = 1,
	}, card)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, btnRow)

	local function actionButton(text, order, primary, onClick)
		local b = new("TextButton", {
			Size = UDim2.new(1 / 3, -16 / 3, 1, 0),
			BackgroundColor3 = theme.text,
			BackgroundTransparency = primary and 0 or 0.88,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = order,
		}, btnRow)
		corner(b, 9)
		if primary then gradient(b, theme.purple, theme.blue, 0) end
		new("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Font = FONT_BOLD,
			Text = text,
			TextColor3 = theme.text,
			TextSize = 13,
			ZIndex = 2,
		}, b)
		b.MouseEnter:Connect(function() tween(b, { BackgroundTransparency = primary and 0.15 or 0.78 }) end)
		b.MouseLeave:Connect(function() tween(b, { BackgroundTransparency = primary and 0 or 0.88 }) end)
		b.MouseButton1Click:Connect(onClick)
	end

	cardDivider(card, 146)

	new("TextLabel", {
		Position = UDim2.fromOffset(8, 84),
		Size = UDim2.new(1, -16, 0, 16),
		BackgroundTransparency = 1,
		Font = FONT_MED,
		Text = "Saved Configs",
		TextColor3 = theme.text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	local list = new("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 102),
		Size = UDim2.new(1, -16, 0, 90),
		BackgroundColor3 = theme.text,
		BackgroundTransparency = 0.94,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = theme.purple,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, card)
	corner(list, 10)
	stroke(list, theme.text, 0.9, 1)
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	new("UIPadding", {
		PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
	}, list)

	local emptyLabel = new("TextLabel", {
		Position = UDim2.fromOffset(8, 102),
		Size = UDim2.new(1, -16, 0, 90),
		BackgroundTransparency = 1,
		Font = FONT,
		Text = "No saved configs yet",
		TextColor3 = theme.muted,
		TextSize = 12,
		ZIndex = 2,
	}, card)

	local function refreshList()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end

		local names = {}
		if canList then
			ensureFolders()
			local ok, files = pcall(listfiles, CONFIG_FOLDER)
			if ok and type(files) == "table" then
				for _, f in ipairs(files) do
					local n = tostring(f):match("([^/\\]+)%.json$")
					if n then table.insert(names, n) end
				end
			end
		end
		table.sort(names)
		emptyLabel.Visible = #names == 0

		for i, n in ipairs(names) do
			local b = new("TextButton", {
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = theme.text,
				BackgroundTransparency = (n == cleanName(nameBox.Text)) and 0.78 or 0.94,
				AutoButtonColor = false,
				Font = FONT_MED,
				Text = n,
				TextColor3 = theme.text,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = i,
			}, list)
			corner(b, 8)
			new("UIPadding", { PaddingLeft = UDim.new(0, 10) }, b)
			b.MouseButton1Click:Connect(function()
				nameBox.Text = n
				refreshList()
			end)
		end
	end

	local function collect()
		local data = {}
		for key, entry in pairs(registry) do
			local ok, v = pcall(entry.get)
			if ok and v ~= nil then data[key] = v end
		end
		return data
	end

	local function writeAutoload(name)
		if not canSave then return end
		ensureFolders()
		pcall(writefile, AUTOLOAD_FILE, name)
	end

	local function loadConfig(name, quiet)
		if name == "" then
			setStatus("Type a config name first", RED)
			return false
		end
		local ok, data = pcall(function()
			if not canSave or not isfile(pathFor(name)) then return nil end
			return HttpService:JSONDecode(readfile(pathFor(name)))
		end)
		if not ok or type(data) ~= "table" then
			setStatus("Config \"" .. name .. "\" not found", RED)
			return false
		end
		for key, value in pairs(data) do
			local entry = registry[key]
			if entry then pcall(entry.set, value) end
		end
		if autoOn then writeAutoload(name) end
		if not quiet then setStatus("Loaded \"" .. name .. "\"", GREEN); notify("Config loaded: " .. name) end
		return true
	end

	actionButton("Save", 1, true, function()
		local name = cleanName(nameBox.Text)
		if name == "" then setStatus("Type a config name first", RED) return end
		if not canSave then setStatus("Your executor can't save files", RED) return end
		ensureFolders()
		local ok = pcall(function()
			writefile(pathFor(name), HttpService:JSONEncode(collect()))
		end)
		if ok then
			nameBox.Text = name
			if autoOn then writeAutoload(name) end
			setStatus("Saved \"" .. name .. "\"", GREEN)
			notify("Config saved: " .. name)
			refreshList()
		else
			setStatus("Couldn't save the config", RED)
		end
	end)

	actionButton("Load", 2, true, function()
		local name = cleanName(nameBox.Text)
		if loadConfig(name) then nameBox.Text = name end
		refreshList()
	end)

	actionButton("Delete", 3, false, function()
		local name = cleanName(nameBox.Text)
		if name == "" then setStatus("Type a config name first", RED) return end
		local removed = false
		if canSave and typeof(delfile) == "function" then
			pcall(function()
				if isfile(pathFor(name)) then
					delfile(pathFor(name))
					removed = true
				end
			end)
		end
		if removed then
			setStatus("Deleted \"" .. name .. "\"", GREEN)
		else
			setStatus("Config \"" .. name .. "\" not found", RED)
		end
		refreshList()
	end)

	cardDivider(card, 298)

	addToggle(card, 400, "Autoload", "Loads the config named above on start", autoOn, function(on)
		autoOn = on
		if not canSave then return end
		if on then
			local name = cleanName(nameBox.Text)
			if name == "" then name = "default" end
			writeAutoload(name)
			setStatus("Will autoload \"" .. name .. "\"", GREEN)
		else
			pcall(function()
				if isfile(AUTOLOAD_FILE) and typeof(delfile) == "function" then delfile(AUTOLOAD_FILE) end
			end)
			setStatus("Autoload off", theme.muted)
		end
	end, true)

	refreshList()

	-- load the autoload config once everything above has been built
	if autoOn and autoName then
		task.delay(0.6, function()
			if gui.Parent then loadConfig(autoName, true); setStatus("Autoloaded \"" .. autoName .. "\"", GREEN) end
		end)
	end
end

