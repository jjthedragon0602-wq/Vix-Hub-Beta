-- true for a moment after a key gets picked, so the same key press
-- can't also trigger the thing it was just bound to
local isBinding = false

-- true for controller (gamepad) input
local function isGamepad(input)
	return input.UserInputType == Enum.UserInputType.Gamepad1
end

local function kname(k) return k == Enum.KeyCode.Unknown and "None" or k.Name end

-- keybind row: [key button]  label   (click the button, then press a key / controller button)
-- mode: "keyboard" or "gamepad" limits what can be bound (nil = either)
local function addKeybind(parent, y, title, desc, default, callback, mode, allowClear)
	y = Y(y)
	local key = default
	local listening = false

	local btn = new("TextButton", {
		Position = UDim2.fromOffset(8, y),
		Size = UDim2.fromOffset(104, 22),
		BackgroundColor3 = theme.purple,
		AutoButtonColor = false,
		Font = FONT_BOLD,
		Text = kname(key),
		TextColor3 = theme.text,
		TextSize = 11,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)
	corner(btn, 2)

	local lbl = new("TextLabel", {
		Position = UDim2.fromOffset(120, y),
		Size = UDim2.new(1, -128, 0, 22),
		BackgroundTransparency = 1,
		Font = FONT,
		Text = title,
		TextColor3 = theme.text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)
	attachTip(lbl, desc)
	attachTip(btn, desc)

	btn.MouseButton1Click:Connect(function()
		listening = true
		isBinding = true
		btn.Text = "..."
	end)

	UserInputService.InputBegan:Connect(function(input)
		if not listening then return end

		local isKey = input.UserInputType == Enum.UserInputType.Keyboard
		local isPad = isGamepad(input)
		if not isKey and not isPad then return end
		if mode == "keyboard" and not isKey then return end
		if mode == "gamepad" and not isPad then return end

		listening = false
		if allowClear and input.KeyCode == Enum.KeyCode.Backspace then
			key = Enum.KeyCode.Unknown -- Backspace clears a hotkey
			if callback then task.spawn(callback, key) end
		elseif input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
			key = input.KeyCode
			if callback then task.spawn(callback, key) end
		end
		btn.Text = kname(key)
		task.defer(function() isBinding = false end)
	end)

	register("key:" .. title, function() return key.Name end, function(name)
		local ok, k = pcall(function() return Enum.KeyCode[name] end)
		if ok and k then
			key = k
			btn.Text = kname(k)
			if callback then task.spawn(callback, k) end
		end
	end)

	grow(parent, y + 22)
	return {
		Get = function() return key end,
	}
end

-- one button that holds a keyboard key AND a controller button
local function addDualKeybind(parent, y, title, desc, defKey, defPad, callback)
	y = Y(y)
	local key, pad = defKey, defPad
	local listening = false

	local function label()
		return key.Name .. " / " .. (pad.Name:gsub("^Button", ""))
	end

	local btn = new("TextButton", {
		Position = UDim2.fromOffset(8, y),
		Size = UDim2.fromOffset(130, 22),
		BackgroundColor3 = theme.purple,
		AutoButtonColor = false,
		Font = FONT_BOLD,
		Text = label(),
		TextColor3 = theme.text,
		TextSize = 11,
	}, parent)
	corner(btn, 2)

	local lbl = new("TextLabel", {
		Position = UDim2.fromOffset(146, y),
		Size = UDim2.new(1, -154, 0, 22),
		BackgroundTransparency = 1,
		Font = FONT,
		Text = title,
		TextColor3 = theme.text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)
	attachTip(lbl, desc)
	attachTip(btn, desc)

	btn.MouseButton1Click:Connect(function()
		listening = true
		isBinding = true
		btn.Text = "..."
	end)

	UserInputService.InputBegan:Connect(function(input)
		if not listening then return end
		local isKey = input.UserInputType == Enum.UserInputType.Keyboard
		local isPad = isGamepad(input)
		if not isKey and not isPad then return end

		listening = false
		if input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode ~= Enum.KeyCode.Unknown then
			if isKey then key = input.KeyCode else pad = input.KeyCode end
			if callback then task.spawn(callback, key, pad) end
		end
		btn.Text = label()
		task.defer(function() isBinding = false end)
	end)

	register("dualkey:" .. title, function() return { key = key.Name, pad = pad.Name } end, function(v)
		if type(v) ~= "table" then return end
		local ok1, k = pcall(function() return Enum.KeyCode[v.key] end)
		local ok2, g = pcall(function() return Enum.KeyCode[v.pad] end)
		if ok1 and k then key = k end
		if ok2 and g then pad = g end
		btn.Text = label()
		if callback then task.spawn(callback, key, pad) end
	end)

	grow(parent, y + 22)
end

