-- a card grows to fit whatever is added to it
local function grow(parent, bottom)
	local want = bottom + 8
	if (parent:GetAttribute("rows") or 0) < want then
		parent:SetAttribute("rows", want)
		parent.Size = UDim2.new(1, 0, 0, want)
	end
end

