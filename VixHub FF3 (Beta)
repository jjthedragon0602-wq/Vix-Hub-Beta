-- LOGIC: FOOTBALL MAGNETS
--------------------------------------------------------------------
local function findClosestBall()
	local character = player.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local dist, ball = math.huge, nil
	for _, v in ipairs(workspace:GetChildren()) do
		if v:IsA("BasePart") and v.Name == "Football" then
			local d = (v.Position - hrp.Position).Magnitude
			if d < dist then dist, ball = d, v end
		end
	end
	return ball
end

local function selectedRange()
	local range = magnets.radius
	local mode = magnets.type:lower()
	if mode == "legit" then return range / 2
	elseif mode == "league" then return range / 1.4
	elseif mode == "blatant" then return range * 1.5 end
	return range
end

local hasFire = typeof(firetouchinterest) == "function"
local magInRangeSince = nil -- when the ball first entered the catch radius (for Catch Delay)
local lastLog = 0

-- prints a status line to the console (F9) at most every 2 seconds
local function log(...)
	if os.clock() - lastLog > 2 then
		lastLog = os.clock()
		print("[Vysxen]", ...)
	end
end

-- finds every "catch" part anywhere on the character; falls back to hands/arms
local function getCatchParts(character)
	local found = {}
	for _, v in ipairs(character:GetDescendants()) do
		if v:IsA("BasePart") and v.Name:lower():find("catch") then
			table.insert(found, v)
		end
	end
	if #found == 0 then
		for _, name in ipairs({ "RightHand", "LeftHand", "Right Arm", "Left Arm", "RightLowerArm", "LeftLowerArm" }) do
			local p = character:FindFirstChild(name)
			if p and p:IsA("BasePart") then table.insert(found, p) end
		end
	end
	return found
end

task.spawn(function()
	while gui.Parent do
		task.wait()

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local ball = humanoid and findClosestBall()
		if not ball then
			hidePreviews(nil)
			magInRangeSince = nil
			continue
		end

		local range = selectedRange()

		-- radius preview
		if magnets.enabled and magnets.showRadius then
			drawPreview(magnets.shape, ball.Position, range, radiusColors[magnets.color])
			hidePreviews(magnets.shape)
		else
			hidePreviews(nil)
		end

		if not magnets.enabled then magInRangeSince = nil; continue end
		if magnets.freefall and humanoid:GetState() ~= Enum.HumanoidStateType.Freefall then
			log("waiting: Freefall Check is on and you're not airborne")
			continue
		end

		local parts = getCatchParts(character)
		log(("ball found | catch parts: %d | range: %.1f | firetouchinterest: %s"):format(
			#parts, range, tostring(hasFire)))

		-- pick the catch part closest to the ball that's inside the radius
		local target, best = nil, math.huge
		for _, v in ipairs(parts) do
			local d = (ball.Position - v.Position).Magnitude
			if d < range and d < best then
				target, best = v, d
			end
		end

		if target and hasFire then
			-- Catch Delay: wait this long after the ball enters the radius before catching
			magInRangeSince = magInRangeSince or os.clock()
			if os.clock() - magInRangeSince >= magnets.delay then
				-- moving the ball only happens on your screen, so just fire the touch
				pcall(function()
					firetouchinterest(target, ball, 0)
					firetouchinterest(target, ball, 1)
				end)
			end
		else
			magInRangeSince = nil
		end
	end

	-- GUI closed: clean up the preview parts
	hidePreviews(nil)
end)

