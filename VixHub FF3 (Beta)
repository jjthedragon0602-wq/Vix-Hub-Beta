-- LOGIC: FREEZE TECH (freezes for a set time, then releases you)
--------------------------------------------------------------------
local function setFrozen(state)
	freeze.frozen = state
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.Anchored = state
		if state then
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

-- freeze now, then unfreeze after `seconds`
local function freezeFor(seconds)
	setFrozen(true)
	freeze.token += 1
	local id = freeze.token
	task.delay(seconds, function()
		-- only release if a newer freeze hasn't started since
		if freeze.token == id then setFrozen(false) end
	end)
end

UserInputService.InputBegan:Connect(function(input, gp)
	if isBinding then return end
	-- controller buttons are often "processed" by Roblox, so only skip that check for keyboard
	if gp and not isGamepad(input) then return end
	if not gui.Parent or not freeze.enabled then return end
	if input.KeyCode == freeze.key or input.KeyCode == Enum.KeyCode.ButtonR1 then
		if freeze.frozen then
			freeze.token += 1 -- pressing again while frozen releases you early
			setFrozen(false)
		else
			freezeFor(freeze.duration)
		end
	end
end)

